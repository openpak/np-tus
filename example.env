NP_CORE_ADDR=localhost:7000
NP_CORE_KEY=change-me-core-internal-key-change-me-internal!
NP_HTTP_ADDR=:8532
NP_TUS_DATABASE_URL=postgres://np_tus:change-me@postgres/np_tus?sslmode=disable
NP_TICKET_KEY=/run/ps3/np-ticket-key.pem
# 20 bytes: firmware resource key slot 6 (VSH 0x684000 XOR 0x7F). Never commit it.
NP_STORAGE_RESOURCE_KEY=/run/ps3/storage-resource-key.bin
# Host the console is told to use for /user_storage/*; must reach np-account's TLS front.
# NP_STORAGE_FQDN=tus.np.community.playstation.net
# Title Small Storage files: <dir>/<commid>/<commid>-<slot>.tss
# NP_TSS_DIR=/srv/tss
